---
const { title = 'ノンアル・ソムリエ | Nonal Sommelier' } = Astro.props;
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="stylesheet" href="/styles/global.css" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital@0;1&family=Yomogi&family=Zen+Kurenaido&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="header">
    <div class="container header-inner">
      <a href="/" class="logo-wrap">
        <div class="logo-icon">N</div>
        <div class="logo-text">
          <span class="logo-main">Nonal Sommelier</span>
          <span class="logo-sub">ノンアル・ソムリエ</span>
        </div>
      </a>
      <nav class="nav">
        <a href="/reviews">レビュー</a>
        <a href="/category">カテゴリー</a>
        <a href="/about">ソムリエとは</a>
      </nav>
    </div>
  </header>
  <main>
    <slot />
  </main>
  <footer class="footer">
    <div class="container footer-inner">
      <span class="footer-logo">Nonal Sommelier ✦</span>
      <span class="footer-copy">© 2026 ノンアル・ソムリエ</span>
    </div>
  </footer>
</body>
</html>
<style>
.header {
  background: #fff;
  border-bottom: 2px solid #E6F1FB;
  position: sticky;
  top: 0;
  z-index: 100;
}
.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 70px;
}
.logo-wrap {
  display: flex;
  align-items: center;
  gap: 12px;
}
.logo-icon {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: linear-gradient(135deg, #185FA5, #378ADD);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Playfair Display', serif;
  font-style: italic;
  font-size: 26px;
  color: #fff;
  box-shadow: 0 3px 8px rgba(24,95,165,0.3);
  flex-shrink: 0;
}
.logo-text {
  display: flex;
  flex-direction: column;
}
.logo-main {
  font-family: 'Playfair Display', serif;
  font-size: 20px;
  font-weight: 700;
  color: #185FA5;
  letter-spacing: 0.04em;
}
.logo-sub {
  font-size: 9px;
  background: #E6F1FB;
  color: #378ADD;
  padding: 2px 8px;
  border-radius: 20px;
  font-weight: 700;
  letter-spacing: 0.1em;
  width: fit-content;
}
.nav {
  display: flex;
  align-items: center;
  gap: 24px;
}
.nav a {
  font-size: 13px;
  color: #444;
  font-weight: 600;
}
.footer {
  background: #042C53;
  padding: 1.5rem 0;
  margin-top: 4rem;
}
.footer-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.footer-logo {
  font-size: 15px;
  font-weight: 700;
  color: #85B7EB;
}
.footer-copy {
  font-size: 11px;
  color: #378ADD;
}
</style>
